# Express server configuration
PORT=5000
NODE_ENV=development

# Database connection URL
# For local testing (via compose.yaml postgres-test on port 5433):
# DATABASE_URL=postgresql://amrutam_test:local_test_password@localhost:5433/amrutam_test?schema=public
# For Docker Compose internal network (compose.prod.yaml):
DATABASE_URL=postgresql://amrutam:your-postgres-password@db:5432/amrutam?schema=public

# Security secrets (JWT_SECRET must be at least 32 characters in production)
JWT_SECRET=your-minimum-32-character-secret-key-here
METRICS_TOKEN=your-random-hex-metrics-token-here

# Database and monitoring credentials
POSTGRES_PASSWORD=your-postgres-password
GRAFANA_ADMIN_PASSWORD=your-grafana-admin-password
